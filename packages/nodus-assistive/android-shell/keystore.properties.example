# Nodus Home Release Keystore Configuration
# Copy this file to keystore.properties and fill in your actual values
# Generate a keystore with: keytool -genkey -v -keystore nodus-release.keystore -keyalg RSA -keysize 2048 -validity 10000 -alias nodus-key

keyAlias=nodus-key
keyPassword=your_keystore_password
storeFile=nodus-release.keystore
storePassword=your_keystore_password