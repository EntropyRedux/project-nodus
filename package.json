{
  "name": "project-nodus-workspace",
  "version": "1.1.1",
  "private": true,
  "description": "Nodus Ecosystem Monorepo & Multi-Device Shell Workspace",
  "workspaces": [
    "packages/nodus-home",
    "packages/nodus-fleet",
    "packages/nodus-desktop",
    "packages/nodus-common"
  ],
  "scripts": {
    "dev:home": "npm run --prefix packages/nodus-home dev",
    "build:home": "npm run --prefix packages/nodus-home build",
    "dev:fleet": "npm run --prefix packages/nodus-fleet dev",
    "build:fleet": "npm run --prefix packages/nodus-fleet build",
    "dev:desktop": "npm run --prefix packages/nodus-desktop tauri dev",
    "build:desktop": "npm run --prefix packages/nodus-desktop tauri build",
    "build": "npm run build --workspaces --if-present",
    "build:all": "npm run build --workspaces --if-present",
    "test:home": "npm run --prefix packages/nodus-home test",
    "test:desktop": "cargo test --manifest-path packages/nodus-desktop/src-tauri/Cargo.toml",
    "test": "npm run test:home && npm run test:desktop",
    "sync:android": "node scripts/sync-android-assets.mjs",
    "clean": "npm run clean --workspaces --if-present"
  },
  "keywords": [
    "nodus",
    "launcher",
    "tablet-os",
    "hyperos",
    "android",
    "fleet-mesh"
  ],
  "author": "EntropyRedux",
  "license": "AGPL-3.0-only"
}