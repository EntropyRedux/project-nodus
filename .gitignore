# Generated Documents — lifecycle tracking rules
# Tracked: context/ (living_context.md, project_brief_v*.md, contracts/), plans/, issues/
# Ignored: audits/, handoffs/, gaps/, test-reports/, archives/, and loose reports
generated-documents/*
!generated-documents/context/
!generated-documents/plans/
!generated-documents/issues/
generated-documents/archives/
generated-documents/audits/
generated-documents/handoffs/
generated-documents/gaps/
generated-documents/test-reports/

