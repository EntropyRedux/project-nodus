{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodus",
  "version": "1.0.0",
  "identifier": "com.nodus.desktop",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Project Nodus Control Plane",
        "width": 420,
        "height": 840,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"]
  }
}
